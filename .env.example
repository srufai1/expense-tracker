# Copy this file to .env.local and fill in the values.
# .env.local is never committed. Never put real values in this file.

# Supabase → Project Settings → API. Both are public (safe in the browser);
# Row-Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for the daily job (src/app/api/cron/daily). Server-only; never put it in
# a NEXT_PUBLIC_ variable. Supabase → Project Settings → API keys → Secret key.
SUPABASE_SECRET_KEY=
# A long random text (32+ characters). Vercel Cron sends it with every run;
# without it the daily job refuses to run. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
